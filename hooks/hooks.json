{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<caminho-do-projeto>/hooks/route-triage.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<caminho-do-projeto>/hooks/erros-resolvidos.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<caminho-do-projeto>/hooks/status-lembrete.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
